# Roustabout server configuration
# Copy to config.toml and customize.

# Rate limiting
rate_limit_per_container = 3
rate_limit_window_seconds = 300
rate_limit_global = 10

# Blast radius cap (max containers affected per batch)
blast_radius_cap = 5

# Default permission tier for unauthenticated local access
default_tier = "operate"

# Notification channels (optional)
# ntfy_url = "https://ntfy.example.com/roustabout"
# apprise_urls = ["discord://webhook", "tgram://token/chat"]

# State database (persists audit trail, circuit breaker state)
# state_db = "/data/roustabout.db"

# API key authentication
# Each key maps to a tier (observe/operate/elevate) and a label for audit trail.
[auth.keys]
# "sk-mcp-abc123" = { tier = "operate", label = "mcp-proxy" }
# "sk-ha-def456" = { tier = "observe", label = "home-assistant" }
# "sk-admin-ghi789" = { tier = "elevate", label = "admin" }
#
# A key can also be granted exec in named containers, whatever its tier.
# A granted key can run only what that container's [exec.<name>] section
# allows, as the user set there. Without a grant, only elevate keys can exec.
# "sk-dags-jkl012" = { tier = "observe", label = "dag-trigger", exec = ["airflow-scheduler"] }

# Per-container exec allowlists.
# An entry must match the command exactly, argument for argument. End an
# entry with * to allow extra arguments after it.
# Elevate keys are also held to this list when a container has one; elevate
# keys can exec into containers without a section (minus a built-in denylist).
# [exec.airflow-scheduler]
# allowed = [
#     "airflow dags trigger nightly_report",   # exactly this, nothing appended
#     "airflow dags list *",                   # any further arguments
# ]
# user = "airflow"    # granted keys run as this user; omit for the container default
# timeout = 30        # seconds; granted keys cannot raise it
